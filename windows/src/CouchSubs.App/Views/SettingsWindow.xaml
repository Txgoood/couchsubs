<Window x:Class="CouchSubs.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CouchSubs.App.Controls"
        xmlns:s="clr-namespace:CouchSubs.App.Views.Steps"
        xmlns:t="clr-namespace:CouchSubs.App.Theme"
        xmlns:local="clr-namespace:CouchSubs.App.Views"
        Title="{t:T 'Settings'}" Width="870" Height="740" MinWidth="730" MinHeight="480" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource backgroundBrush}" Foreground="{DynamicResource textPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="SettingsNavigationItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource textPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
            <Setter Property="FontSize" Value="{DynamicResource bodyFontSize}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"
                                Background="Transparent" CornerRadius="{DynamicResource radius.control}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource backgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource accentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource accentTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource accentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource surfaceBrush}" BorderBrush="{DynamicResource borderBrush}"
                BorderThickness="0,0,0,1" Padding="24,19,24,15">
            <TextBlock Text="{t:T 'Settings'}" Style="{StaticResource TitleText}" />
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource surfaceBrush}" BorderBrush="{DynamicResource borderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{t:T 'Done'}" Style="{StaticResource PrimaryButton}" IsCancel="True" Click="OnDone" />
                <TextBlock Text="Değişiklikler otomatik kaydedilir." Style="{StaticResource HintText}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource surfaceBrush}" BorderBrush="{DynamicResource borderBrush}"
                    BorderThickness="0,0,1,0" Padding="14,18,14,12">
                <ListBox x:Name="SettingsNavigation" SelectionChanged="OnSectionChanged" AutomationProperties.Name="Ayar kategorileri"
                         Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource SettingsNavigationItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Content="Çeviri" />
                    <ListBoxItem Content="Altyazı" />
                    <ListBoxItem Content="Dublaj" />
                    <ListBoxItem Content="Ekran ve alan" />
                    <ListBoxItem Content="Kısayollar" />
                    <ListBoxItem Content="TV ve OBS" />
                    <ListBoxItem Content="Uygulama" />
                </ListBox>
            </Border>
            <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid x:Name="SettingsPages" Margin="24,18,24,24">
                    <StackPanel>
                        <TextBlock Text="Çeviri" Style="{StaticResource HeadlineText}" Margin="0,0,0,12" />
                        <c:Card Title="Oyun içi menü ve nesne çevirisi">
                            <StackPanel>
                                <CheckBox x:Name="AutoWorldText" Checked="OnAutoWorldText" Unchecked="OnAutoWorldText"
                                          Foreground="{DynamicResource textPrimaryBrush}">
                                    <TextBlock Text="Menü, envanter, harita ve nesne yazılarını otomatik Türkçeye çevir" />
                                </CheckBox>
                                <TextBlock Text="Menü yazıları değiştikçe yenilenir. Oyun altyazısı ve Türkçe dublaj ayrı çalışır."
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <CheckBox x:Name="PcPerformanceProfile" Checked="OnPcPerformanceProfile" Unchecked="OnPcPerformanceProfile"
                                          Content="PXPlay / PC akıcı oyun profili" Margin="0,12,0,0"
                                          Foreground="{DynamicResource textPrimaryBrush}" />
                                <TextBlock Text="Hareket sırasında menü OCR yükünü azaltır; yeni menüleri hızlı algılar. Altyazı ve dublaj önceliği korunur."
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </c:Card>
                        <c:Card x:Name="LanguageCard" Title="{t:T 'Language'}" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{t:T 'Game language'}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <ComboBox x:Name="GameLanguage" SelectionChanged="OnLanguage" />
                            </StackPanel>
                        </c:Card>
                        <c:Card Title="{t:T 'Online translation (DeepL)'}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12"
                                           Text="DeepL diyalogları çevirir. Kota dolarsa veya yanıt gecikirse yerel model devreye girer. Yerel model kuruluysa menü ve ekran çevirileri kotayı kullanmaz." />
                                <StackPanel x:Name="DeepLNewKey">
                                    <Label Content="DeepL API anahtarı" Target="{Binding ElementName=DeepLKey}" Padding="0,0,0,6"
                                           Foreground="{DynamicResource textPrimaryBrush}" />
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="DeepLSave" DockPanel.Dock="Right" Content="{t:T 'Save and test'}" Margin="12,0,0,0" Click="OnDeepLSave" />
                                        <PasswordBox x:Name="DeepLKey" VerticalContentAlignment="Center" Padding="10,0"
                                                     Background="{DynamicResource backgroundBrush}" Foreground="{DynamicResource textPrimaryBrush}"
                                                     BorderBrush="{DynamicResource borderBrush}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,8,0,0">
                                        <Hyperlink NavigateUri="https://www.deepl.com/pro-api" RequestNavigate="OnLink"><Run Text="{t:T 'Get a free DeepL API key'}" /></Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel x:Name="DeepLSaved">
                                    <CheckBox x:Name="DeepLOn" Content="{t:T 'Translate with DeepL'}" Foreground="{DynamicResource textPrimaryBrush}"
                                              Checked="OnDeepLToggle" Unchecked="OnDeepLToggle" />
                                    <Button Content="{t:T 'Remove key'}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnDeepLRemove" />
                                </StackPanel>
                                <TextBlock x:Name="DeepLStatus" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                        </c:Card>
                    </StackPanel>
                    <StackPanel Visibility="Collapsed">
                        <TextBlock Text="Altyazı" Style="{StaticResource HeadlineText}" Margin="0,0,0,12" />
                        <c:Card Title="{t:T 'On the TV'}">
                            <StackPanel>
                                <TextBlock Text="{t:T 'Text size'}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{t:T 'Small'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                    <!-- Sürüklerken TV'de örnek altyazı görünür; boyut doğrudan ekranda ayarlanır. -->
                                    <Slider x:Name="TextSize" Grid.Column="1" Minimum="16" Maximum="90" SmallChange="1" LargeChange="4" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Margin="12,0" IsMoveToPointEnabled="True"
                                            ValueChanged="OnTextSize" PreviewMouseDown="OnPositionStart" />
                                    <TextBlock Grid.Column="2" Text="{t:T 'Large'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TextSizeValue" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{t:T 'Placement'}" Margin="0,0,0,8" />
                                <ComboBox x:Name="Placement" SelectionChanged="OnPlacement" Margin="0,0,0,8">
                                    <ComboBoxItem Content="{t:T 'Over the English subtitle'}" Tag="Cover" />
                                    <ComboBoxItem Content="{t:T 'Above the English subtitle'}" Tag="Above" />
                                    <ComboBoxItem Content="{t:T 'Below the English subtitle'}" Tag="Below" />
                                    <ComboBoxItem Content="{t:T 'Fixed position'}" Tag="Fixed" />
                                </ComboBox>
                                <TextBlock x:Name="FollowsHint" Style="{StaticResource HintText}" Margin="0,0,0,16"
                                           Text="{t:T 'The translation follows where the game shows its own subtitle.'}" />
                                <StackPanel x:Name="FixedPanel">
                                <TextBlock Text="{t:T 'Position on screen'}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{t:T 'Bottom'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                    <!-- Sürüklerken TV'de örnek altyazı görünür; böylece yer doğrudan ekranda ayarlanır. -->
                                    <Slider x:Name="Position" Grid.Column="1" Minimum="0" Maximum="85" Margin="12,0" IsMoveToPointEnabled="True"
                                            ValueChanged="OnPosition" PreviewMouseDown="OnPositionStart" />
                                    <TextBlock Grid.Column="2" Text="{t:T 'Top'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,16"
                                           Text="{t:T 'In fixed position you can also move subtitles with the ▲ and ▼ buttons on the TV remote.'}" />
                                </StackPanel>
                                <TextBlock Text="{t:T 'Background'}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{t:T 'None'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                    <Slider x:Name="BackgroundOpacity" Grid.Column="1" Minimum="0" Maximum="100" Margin="12,0" IsMoveToPointEnabled="True"
                                            ValueChanged="OnBackground" PreviewMouseDown="OnPositionStart" />
                                    <TextBlock Grid.Column="2" Text="{t:T 'Solid'}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Türkçe altyazı rengi" Margin="0,0,0,8" />
                                <ComboBox x:Name="SubtitleColor" SelectionChanged="OnSubtitleColor" Margin="0,0,0,16">
                                    <ComboBoxItem Content="Beyaz" Tag="White" />
                                    <ComboBoxItem Content="Sarı" Tag="Yellow" />
                                    <ComboBoxItem Content="Açık mavi" Tag="Cyan" />
                                </ComboBox>
                                <TextBlock Text="Altyazı süresi" Margin="0,0,0,8" />
                                <ComboBox x:Name="SubtitleTiming" SelectionChanged="OnSubtitleTiming" Margin="0,0,0,8">
                                    <ComboBoxItem Content="Akıllı: konuşma ve okuma hızına göre" Tag="Adaptive" />
                                    <ComboBoxItem Content="İngilizce altyazıyla aynı süre" Tag="MatchEnglish" />
                                    <ComboBoxItem Content="Ek okuma süresi" Tag="Extended" />
                                </ComboBox>
                                <TextBlock Text="Yeni İngilizce konuşma başladığında önceki Türkçe altyazı kaldırılır. İngilizce altyazının kapatılması, oyunun metin katmanını silmez: Türkçe kutu metnin üzerini örter."
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <CheckBox x:Name="Bold" Content="{t:T 'Bold text'}" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,16"
                                          Checked="OnBold" Unchecked="OnBold" />
                                <Button Content="{t:T 'Send test subtitle'}" Click="OnTest" />
                            </StackPanel>
                        </c:Card>
                    </StackPanel>
                    <StackPanel Visibility="Collapsed">
                        <TextBlock Text="Dublaj" Style="{StaticResource HeadlineText}" Margin="0,0,0,12" />
                        <local:DubbingCard x:Name="Dubbing" />
                    </StackPanel>
                    <StackPanel Visibility="Collapsed">
                        <TextBlock Text="Ekran ve alan" Style="{StaticResource HeadlineText}" Margin="0,0,0,12" />
                        <c:Card Title="Ekranı çevir">
                            <StackPanel>
                                <Button x:Name="ScreenActionButton" HorizontalAlignment="Left" Click="OnScreenAction" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="Oynarken Kısayollar bölümünde atadığın tuşa bas: ekrandaki bütün yazılar bir kez çevrilir; tekrar basınca kaldırılır." />
                            </StackPanel>
                        </c:Card>
                        <c:Card Title="{t:T 'Subtitle area'}" Margin="0,16,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,12" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="{t:T 'Subtitles'}" GroupName="area" Style="{StaticResource SegmentButton}" Checked="OnArea" Tag="0" IsChecked="True" />
                                        <RadioButton Content="Ek bölge 1" GroupName="area" Style="{StaticResource SegmentButton}" Checked="OnArea" Tag="1" />
                                        <RadioButton Content="Ek bölge 2" GroupName="area" Style="{StaticResource SegmentButton}" Checked="OnArea" Tag="2" />
                                        <RadioButton Content="Ek bölge 3" GroupName="area" Style="{StaticResource SegmentButton}" Checked="OnArea" Tag="3" />
                                    </StackPanel>
                                </Border>
                                <CheckBox x:Name="UseArea" Content="{t:T 'Use this area'}" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,12"
                                          Visibility="Collapsed" Checked="OnUseArea" Unchecked="OnUseArea" />
                                <StackPanel x:Name="ExtraTargetPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                    <TextBlock Text="{t:T 'Show the result'}" Margin="0,0,0,8" />
                                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ExtraTv" Content="{t:T 'On the TV'}" GroupName="extraTarget" Style="{StaticResource SegmentButton}" Checked="OnExtraTarget" Tag="Tv" />
                                            <RadioButton x:Name="ExtraPc" Content="{t:T 'On the PC'}" GroupName="extraTarget" Style="{StaticResource SegmentButton}" Checked="OnExtraTarget" Tag="Pc" />
                                            <RadioButton x:Name="ExtraBoth" Content="{t:T 'On both'}" GroupName="extraTarget" Style="{StaticResource SegmentButton}" Checked="OnExtraTarget" Tag="Both" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <c:RegionPicker x:Name="Region" RegionChanged="OnRegion" />
                                <Button x:Name="RefreshPictureButton" Click="OnRefresh" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                <TextBlock x:Name="AreaHint" Style="{StaticResource HintText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </c:Card>
                        <c:Card Title="Serbest alan" Margin="0,16,0,0">
                            <StackPanel>
                                <Button x:Name="FreeAreaActionButton" HorizontalAlignment="Left" Click="OnFreeAreaAction" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Oynarken Kısayollar bölümünde atadığın tuşa bas: görüntü bilgisayarda donar, çevirmek istediğin yeri fareyle seç. Esc kapatır." />
                                <TextBlock Text="{t:T 'Show the result'}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,12" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="FreeTv" Content="{t:T 'On the TV'}" GroupName="freeTarget" Style="{StaticResource SegmentButton}" Checked="OnFreeTarget" Tag="Tv" />
                                        <RadioButton x:Name="FreePc" Content="{t:T 'On the PC'}" GroupName="freeTarget" Style="{StaticResource SegmentButton}" Checked="OnFreeTarget" Tag="Pc" />
                                        <RadioButton x:Name="FreeBoth" Content="{t:T 'On both'}" GroupName="freeTarget" Style="{StaticResource SegmentButton}" Checked="OnFreeTarget" Tag="Both" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Altyazıyı duraklatma veya sürdürme için Kısayollar bölümündeki tuşu kullan." />
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="{t:T 'Atadığın kısayollar yalnız çeviri açıkken çalışır. Num kısayolları için Num Lock açık olmalı.'}" />
                            </StackPanel>
                        </c:Card>
                    </StackPanel>
                    <StackPanel Visibility="Collapsed">
                        <TextBlock Text="Kısayollar" Style="{StaticResource HeadlineText}" Margin="0,0,0,12" />
                        <c:Card Title="Tuş atamaları">
                            <StackPanel>
                                <TextBlock Text="Her işlev için farklı bir F1–F11 veya Num 0–9 tuşu seç."
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                    <ComboBox x:Name="ScreenHotkeyPicker" Width="145" DockPanel.Dock="Right"
                                              SelectionChanged="OnHotkeysChanged" />
                                    <TextBlock Text="Ekranın tamamını çevir" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                    <ComboBox x:Name="FreeAreaHotkeyPicker" Width="145" DockPanel.Dock="Right"
                                              SelectionChanged="OnHotkeysChanged" />
                                    <TextBlock Text="Serbest alan seç" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                    <ComboBox x:Name="PauseHotkeyPicker" Width="145" DockPanel.Dock="Right"
                                              SelectionChanged="OnHotkeysChanged" />
                                    <TextBlock Text="Canlı altyazıyı duraklat / sürdür" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                    <ComboBox x:Name="Region1HotkeyPicker" Width="145" DockPanel.Dock="Right"
                                              SelectionChanged="OnHotkeysChanged" />
                                    <TextBlock Text="Ek bölge 1&apos;i çevir" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                    <ComboBox x:Name="Region2HotkeyPicker" Width="145" DockPanel.Dock="Right"
                                              SelectionChanged="OnHotkeysChanged" />
                                    <TextBlock Text="Ek bölge 2&apos;yi çevir" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                    <ComboBox x:Name="Region3HotkeyPicker" Width="145" DockPanel.Dock="Right"
                                              SelectionChanged="OnHotkeysChanged" />
                                    <TextBlock Text="Ek bölge 3&apos;ü çevir" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                    <ComboBox x:Name="SnapshotHotkeyPicker" Width="145" DockPanel.Dock="Right"
                                              SelectionChanged="OnHotkeysChanged" />
                                    <TextBlock Text="Oyun görüntüsü önizlemesini yenile" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                                <TextBlock Text="Seçimler otomatik kaydedilir ve çeviri sırasında hemen uygulanır. Num tuşları için Num Lock açık olmalı."
                                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </c:Card>
                    </StackPanel>
                    <StackPanel Visibility="Collapsed">
                        <TextBlock Text="TV ve OBS" Style="{StaticResource HeadlineText}" Margin="0,0,0,12" />
                        <c:Card Title="{t:T 'OBS overlay'}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="{t:T 'Streaming with a capture card? In OBS add a Browser source with this address (width 1920, height 1080). The Turkish subtitles appear over the game on your screen and on the stream.'}" />
                                <DockPanel>
                                    <Button x:Name="ObsCopy" DockPanel.Dock="Right" Content="{t:T 'Copy'}" Margin="12,0,0,0" Click="OnObsCopy" />
                                    <TextBox x:Name="ObsAddress" IsReadOnly="True" FontFamily="Consolas" VerticalContentAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Menü ve ekran çevirisi katmanı" Margin="0,10,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{t:T 'Copy'}" Margin="12,0,0,0" Click="OnObsScreenCopy" />
                                    <TextBox x:Name="ObsScreenAddress" IsReadOnly="True" FontFamily="Consolas" VerticalContentAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Text="{t:T 'If OBS runs on another computer, use the network address of this PC instead of localhost. The overlay only shows subtitles while the translation is running.'}" />
                            </StackPanel>
                        </c:Card>
                        <s:TvAppCard Margin="0,16,0,0" />
                    </StackPanel>
                    <StackPanel Visibility="Collapsed">
                        <TextBlock Text="Uygulama" Style="{StaticResource HeadlineText}" Margin="0,0,0,12" />
                        <c:Card>
                            <Grid>
                                <Button Content="{t:T 'About CouchSubs'}" Click="OnAbout" />
                                <Button Content="{t:T 'Set up again…'}" HorizontalAlignment="Right" Foreground="{DynamicResource dangerBrush}" Click="OnReset" />
                            </Grid>
                        </c:Card>
                        <TextBlock x:Name="BuildInfo" Style="{StaticResource HintText}" Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
