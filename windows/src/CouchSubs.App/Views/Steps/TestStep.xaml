<UserControl x:Class="CouchSubs.App.Views.Steps.TestStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Glyph="{x:Static c:Glyphs.Seal}" Title="{t:T 'Let\'s test it'}"
                  Message="{t:T 'CouchSubs will show a sample Turkish subtitle on your chosen display (TV or secondary PC monitor).'}">
        <StackPanel>
            <Button x:Name="Send" Content="{t:T 'Send test subtitle'}" Style="{StaticResource PrimaryButton}" Click="OnSend" />
            <c:Card x:Name="Question" Title="{t:T 'Can you see the test subtitle on your display?'}" Margin="0,20,0,0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{t:T 'Yes, I see it'}" Style="{StaticResource PrimaryButton}" Click="OnYes" IsDefault="True" />
                        <Button Content="{t:T 'No'}" Margin="12,0,0,0" Click="OnNo" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0"
                               Text="{t:T 'If using a second PC monitor, check the Dell display. Otherwise check your TV app.'}" />
                </StackPanel>
            </c:Card>
        </StackPanel>
    </c:StepLayout>
</UserControl>
