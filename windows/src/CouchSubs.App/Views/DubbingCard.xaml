<UserControl x:Class="CouchSubs.App.Views.DubbingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme"
             Visibility="Collapsed">
    <c:Card Title="{t:T 'Turkish dubbing'}">
        <StackPanel>
            <CheckBox x:Name="Enabled" Content="{t:T 'Voice the translation in Turkish'}" Foreground="{DynamicResource textPrimaryBrush}"
                      Checked="OnEnabled" Unchecked="OnEnabled" />
            <TextBlock x:Name="SetupHint" Style="{StaticResource HintText}" Margin="0,8,0,0" />
            <StackPanel x:Name="Options" Margin="0,12,0,0">
                <StackPanel x:Name="EnginePanel" Margin="0,0,0,16">
                    <TextBlock Text="{t:T 'Voice'}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="NaturalEngine" Content="{t:T 'Natural'}" GroupName="engine" Style="{StaticResource SegmentButton}" Checked="OnEngine" Tag="Natural" />
                            <RadioButton x:Name="FastEngine" Content="{t:T 'Fast'}" GroupName="engine" Style="{StaticResource SegmentButton}" Checked="OnEngine" Tag="Fast" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="EngineHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel x:Name="DownloadPanel">
                    <TextBlock Text="{t:T 'The voices are downloaded once (440 MB).'}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                    <Button x:Name="DownloadButton" Content="{t:T 'Download voices'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnDownload" />
                    <ProgressBar x:Name="Progress" Height="6" Maximum="1" Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource HintText}" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="ReadyPanel">
                    <TextBlock Text="{t:T 'Play the voice on'}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,16" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="OnTv" Content="LG TV (webOS)" GroupName="output" Style="{StaticResource SegmentButton}" Checked="OnOutput" Tag="Tv" />
                            <RadioButton x:Name="OnAgon" Content="Agon monitör" GroupName="output" Style="{StaticResource SegmentButton}" Checked="OnOutput" Tag="Agon" />
                            <RadioButton x:Name="OnHeadset" Content="PS5 kulaklık" GroupName="output" Style="{StaticResource SegmentButton}" Checked="OnOutput" Tag="Headset" />
                            <RadioButton x:Name="OnComputer" Content="{t:T 'This computer'}" GroupName="output" Style="{StaticResource SegmentButton}" Checked="OnOutput" Tag="Computer" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="OutputHint" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <!-- Oyun bazlı ses hafızası: ayrı oyun kayıtları, karakter sayısı sınırı yok. -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Oyun ve karakter hafızası" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="GTA 5, GTA 6 veya diğer oyunun adını gir. Karakterler bu oyuna özel saklanır; önceki oyunun sesleri silinmez."
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="GameSelection" Width="170" SelectionChanged="OnGameSelection" Margin="0,0,8,0" />
                            <TextBox x:Name="GameName" Width="205" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                     ToolTip="Örneğin: GTA 5, GTA 6, Peppa Pig" />
                            <Button Content="Oyunu seç / ekle" Click="OnSelectGame" />
                        </StackPanel>
                        <TextBlock x:Name="GameInfo" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                        <TextBlock Text="Elle karakter ekle" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="CharacterName" Width="205" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" ToolTip="Örneğin: Michael, Franklin, Trevor" />
                            <ComboBox x:Name="NewCharacterGroup" Width="145" Margin="0,0,8,0">
                                <ComboBoxItem Content="Bilinmeyen" Tag="Unknown" IsSelected="True" />
                                <ComboBoxItem Content="Erkek" Tag="Male" />
                                <ComboBoxItem Content="Kadın" Tag="Female" />
                                <ComboBoxItem Content="Çocuk" Tag="Child" />
                                <ComboBoxItem Content="Canlı / Fantastik" Tag="Creature" />
                                <ComboBoxItem Content="Anlatıcı" Tag="Narrator" />
                            </ComboBox>
                            <Button Content="Karakter ekle" Click="OnAddCharacter" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBox x:Name="CharacterSearch" Width="240" ToolTip="Karakter adına göre filtrele"
                                 TextChanged="OnCharacterSearch" Margin="0,0,8,0" />
                        <Button Content="Önceki" Click="OnPreviousCharacters" Margin="0,0,6,0" />
                        <Button Content="Sonraki" Click="OnNextCharacters" />
                        <TextBlock x:Name="CharacterPageInfo" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Style="{StaticResource HintText}" />
                    </StackPanel>
                    <StackPanel x:Name="Voices" />
                    <TextBlock x:Name="Credits" Style="{StaticResource HintText}" Margin="0,12,0,0" />
                </StackPanel>
                <TextBlock x:Name="Error" Foreground="{DynamicResource dangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </c:Card>
</UserControl>
