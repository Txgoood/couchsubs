<UserControl x:Class="CouchSubs.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme"
             xmlns:local="clr-namespace:CouchSubs.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <!-- Başlık: logo, ad, ayarlar -->
            <Grid Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="44" Height="44">
                        <Image Source="/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- Koyu temada logonun kenarı zeminden ayrılsın. -->
                        <Border BorderBrush="{DynamicResource borderBrush}" BorderThickness="1" CornerRadius="9.9" />
                    </Grid>
                    <TextBlock Text="CouchSubs" Style="{StaticResource TitleText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="{t:T 'Settings'}" Click="OnSettings"
                        AutomationProperties.Name="{t:T 'Settings'}">
                    <TextBlock Text="{x:Static c:Glyphs.Settings}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource textSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Yeni sürüm -->
            <c:Card x:Name="UpdateCard" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" Foreground="{DynamicResource accentBrush}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateBar" Minimum="0" Maximum="1" Margin="0,12,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="UpdateErrorText" Foreground="{DynamicResource dangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                    <Button x:Name="UpdateButton" Content="{t:T 'Update now'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Click="OnUpdate" />
                </StackPanel>
            </c:Card>

            <!-- Oyun kaynağı: PS5 korunur, PC'de ekran seçimi yerel olarak yapılır. -->
            <c:Card Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Oyun kaynağı" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox x:Name="SourceSelection" SelectionChanged="OnSourceChanged" AutomationProperties.Name="Oyun kaynağı">
                        <ComboBoxItem Content="PS5 · Konsola doğrudan bağlan" Tag="Ps5" />
                        <ComboBoxItem Content="Bilgisayar ekranı · PC oyunu veya PXPlay" Tag="Pc" />
                    </ComboBox>
                    <StackPanel x:Name="PcDisplayPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="Oyunun açık olduğu ekran" Margin="0,0,0,6" />
                        <ComboBox x:Name="PcDisplaySelection" SelectionChanged="OnPcDisplayChanged" AutomationProperties.Name="Oyun ekranı" />
                        <Button x:Name="RefreshDisplays" Content="Ekranları yenile" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRefreshDisplays" />
                        <TextBlock Text="PXPlay veya PC oyununun göründüğü ekranı seç."
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="DisplaySelectionStatus" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Text="{Binding PcCaptureError}" Foreground="{DynamicResource dangerBrush}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="{Binding PcCaptureError, Converter={StaticResource VisibleIf}}" />
                    </StackPanel>
                </StackPanel>
            </c:Card>

            <!-- Başlat / Durdur -->
            <Button x:Name="Toggle" HorizontalAlignment="Stretch" MinHeight="{DynamicResource size.primaryActionHeight}" Click="OnToggle"
                    IsEnabled="{Binding IsStarting, Converter={StaticResource Not}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToggleGlyph" Style="{StaticResource GlyphText}" FontSize="16" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock x:Name="ToggleText" FontSize="{DynamicResource headlineFontSize}" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding StartError}" Foreground="{DynamicResource dangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding StartError, Converter={StaticResource VisibleIf}}" />
            <WrapPanel Margin="0,10,0,0">
                <Button Content="Ekranı çevir" IsEnabled="{Binding IsRunning}" Click="OnTranslateScreen" Margin="0,0,8,6" />
                <Button x:Name="PauseButton" Content="Altyazıyı duraklat" IsEnabled="{Binding IsRunning}" Click="OnPauseSubtitles" Margin="0,0,8,6" />
                <Button Content="Çeviri hafızası" Click="OnTranslationMemory" Margin="0,0,0,6"
                        Visibility="{Binding HasTranslationMemory, Converter={StaticResource VisibleIf}}" />
            </WrapPanel>
            <TextBlock x:Name="ScreenActionStatus" Style="{StaticResource HintText}" TextWrapping="Wrap"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleIf}}" />

            <c:Card x:Name="SmoothVideoCard" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Button x:Name="SmoothVideoButton" Content="Akıcı görüntü · 2×" Click="OnSmoothVideo"
                            HorizontalAlignment="Left" IsEnabled="{Binding IsRunning}"
                            AutomationProperties.Name="Akıcı görüntüyü aç veya kapat" />
                    <TextBlock x:Name="SmoothVideoStatus"
                               Text="Kapalı · Ctrl+Shift+F8"
                               Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </c:Card>

            <!-- Durumlar -->
            <c:Card x:Name="ConsoleStatusCard" Margin="0,24,0,0">
                <StackPanel>
                    <c:StatusRow Title="PS5" Value="{Binding Ps5StatusText}" Tone="{Binding Ps5Tone}" />
                    <Separator />
                    <c:StatusRow Title="TV" Value="{Binding TvStatusText}" Tone="{Binding TvTone}" />
                </StackPanel>
            </c:Card>

            <!-- PS5 ya da TV uzun süredir bağlanamıyor ve güvenlik duvarında izin yok -->
            <local:FirewallCard Margin="0,16,0,0" />

            <!-- Çeviri modeli eksik -->
            <c:Card x:Name="ModelCard" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{t:T 'The translation model is not downloaded yet.'}" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}}" Margin="0,12,0,0">
                        <TextBlock Text="{t:T 'Downloading…'}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ModelProgress, Mode=OneWay}" />
                    </StackPanel>
                    <Button Content="{t:T 'Download the model'}" Margin="0,12,0,0" Click="OnDownload"
                            Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding ModelError}" Foreground="{DynamicResource dangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding ModelError, Converter={StaticResource VisibleIf}}" />
                </StackPanel>
            </c:Card>

            <!-- Yazı tanıma dili eksik -->
            <c:Card Margin="0,16,0,0" Visibility="{Binding OcrMissing, Converter={StaticResource VisibleIf}}">
                <StackPanel>
                    <TextBlock Text="{t:T 'Text recognition for the game language is not installed on this computer.'}" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,12" TextWrapping="Wrap"
                               Text="{t:T 'Without it Windows reads the subtitles with your system language and the translation turns into nonsense. Install it once; Windows asks for permission.'}" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="InstallOcr" Content="{t:T 'Install text recognition'}" Click="OnInstallOcr" />
                        <Button Content="{t:T 'Open language settings'}" Click="OnLanguageSettings" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="OcrInstallStatus" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </c:Card>

            <!-- Son altyazı -->
            <TextBlock Text="{Binding DeepLNotice}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,16,0,0"
                       Visibility="{Binding DeepLNotice, Converter={StaticResource VisibleIf}}" />
            <c:Card Margin="0,16,0,0">
                <Expander Header="Çeviri inceleme kaydı" Foreground="{DynamicResource textPrimaryBrush}">
                  <StackPanel Margin="0,10,0,0">
                    <CheckBox x:Name="InspectionEnabled" Content="Son 20 saniyeyi sesli olarak bellekte tut"
                              Foreground="{DynamicResource textPrimaryBrush}"
                              Checked="OnInspectionToggle" Unchecked="OnInspectionToggle" />
                    <Button x:Name="SaveInspectionButton" Content="Son 20 saniyeyi kaydet · Ctrl+Shift+F9"
                            Click="OnSaveInspection" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <TextBlock x:Name="InspectionStatus" Style="{StaticResource HintText}" TextWrapping="Wrap"
                               Margin="0,6,0,0" Text="Klip seçilen ekranı ve varsayılan Windows ses çıkışında çalan sesleri içerir. Mikrofon kullanılmaz. Kaydettiğinizde klip ve çeviri dökümü bu bilgisayara yazılır." />
                  </StackPanel>
                </Expander>
            </c:Card>
            <c:Card Title="{t:T 'Last subtitle'}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{t:T 'Subtitles will appear here while you play.'}" Style="{StaticResource HintText}"
                               Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding LastTranslation}" Style="{StaticResource TitleText}" FontWeight="Medium"
                               Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                    <TextBlock Text="{Binding LastSource}" Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                </StackPanel>
            </c:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
