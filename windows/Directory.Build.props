<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Company>Enmera</Company>
    <Product>CouchSubs TR</Product>
    <Copyright>AGPL-3.0. Uses chiaki-ng (AGPL-3.0).</Copyright>
    <!-- WPF projesi Mac'te de derlenebilsin (çalıştırmak için Windows gerekir). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
