<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.3</Version>
    <AssemblyVersion>0.1.3.127</AssemblyVersion>
    <FileVersion>0.1.3.127</FileVersion>
    <InformationalVersion>0.1.3-prosody.127</InformationalVersion>
    <Company>Enmera</Company>
    <Product>CouchSubs</Product>
    <Copyright>AGPL-3.0. Uses chiaki-ng (AGPL-3.0).</Copyright>
    <!-- WPF projesi Mac'te de derlenebilsin (çalıştırmak için Windows gerekir). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
